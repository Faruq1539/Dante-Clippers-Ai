# App
ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=postgresql://dante:dante@localhost:5432/dante_clippers

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible)
STORAGE_BUCKET=dante-clippers-dev
STORAGE_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Credits
MONTHLY_FREE_CREDITS=60

# Third-party platform OAuth (fill in as you register apps)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
